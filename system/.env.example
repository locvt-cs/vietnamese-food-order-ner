# Copy to system/.env and fill locally. Never commit credentials.
# Alternatively export variables in the terminal before starting the API.
MONGODB_URI=mongodb+srv://24521185_db_user:UvDz599qcsmHVQTf@cluster0.gkyqt7a.mongodb.net
MONGODB_DB=food_orders_dev
# Optional: leave empty to use system DNS. Set only if SRV/TXT lookup fails.
MONGODB_DNS_SERVERS=
PORT=3001
# Relative paths are resolved from system/, independent of terminal directory.
PYTHON_EXECUTABLE=../../env/Scripts/python.exe
VNCORENLP_DIR=.cache/vncorenlp
NER_MODEL=CS221DoAn/vietnamese_food_order_extraction
# Local files only by default: no implicit model download on an HTTP request.
NER_LOCAL_FILES_ONLY=true
